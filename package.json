{
  "name": "agentic",
  "version": "0.2.0",
  "description": "Seed an agentic harness into .agentic/ and link it into Claude Code, Antigravity CLI, and Codex CLI config",
  "type": "module",
  "files": [
    "dist/"
  ],
  "bin": {
    "agentic": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "gray-matter": "^4.0.3",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
